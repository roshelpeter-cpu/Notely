# Copy to .env and adjust if needed. No secrets are required for local Notely.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# SQLite file. Use an absolute path if you prefer.
# NOTELY_DB=server/data/notely.db

# Set to 0 to start with an empty database instead of fictional sample data.
NOTELY_AUTO_SEED=1

# Sample library password used only by the local seed script. Change it if you seed a shared machine.
NOTELY_SEED_PASSWORD=woodland-sample-1

# Set to 0 in production. In development, password reset returns a local link because no mail server is configured.
NOTELY_DEV_RESET=1
